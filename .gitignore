__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Clips, extracted transitions and generated episodes are far too big for git. The small
# files that describe the physical setup are not, and nothing reproduces without them.
data/**
!data/raw/
!data/raw/dots.yaml
!data/raw/recording_log.csv
!data/raw/clip_files.csv
!data/calib/
!data/calib/*.yaml
data/raw/*.mp4
data/human/
data/robot/

checkpoints/
third_party/

*.mp4
!results/**/*.mp4
# Per-clip extraction previews are regenerated by extract_human.py. Three stay in git
# as examples: a success, an F1 (block stays put), an F2 (block is dropped).
results/extract_demo_*.mp4
!results/extract_demo_001.mp4
!results/extract_demo_031.mp4
!results/extract_demo_035.mp4

.DS_Store

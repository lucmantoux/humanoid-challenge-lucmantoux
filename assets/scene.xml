<mujoco model="palm-prior table">
  <!--
    The stage: floor, lights, camera and the four objects. The Panda itself is attached at
    load time from MuJoCo Menagerie (via the robot_descriptions package), together with a
    `tcp` site between the fingertips, by src/palm_prior/sim/scene.py.

    Sizes, masses, frictions and object positions below are OVERWRITTEN from
    configs/default.yaml by that same function. The numbers here are the current config
    values, present only so this file can be opened on its own in the MuJoCo viewer.
    configs/default.yaml is the authority; never tune a number in this file.
  -->

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="960"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.42 0.44 0.47" rgb2="0.33 0.35 0.38" markrgb="0.6 0.6 0.6" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0"/>
    <material name="block_mat" rgba="0.10 0.35 0.85 1"/>
    <material name="plate_mat" rgba="0.93 0.93 0.90 1"/>
    <material name="pad_mat" rgba="0.85 0.45 0.10 1"/>
    <material name="box_mat" rgba="0.25 0.62 0.30 1"/>
  </asset>

  <worldbody>
    <light pos="0.9 -0.4 1.8" dir="-0.3 0.2 -1" directional="true" castshadow="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Facing the robot from the front right, 40 deg down, framed on the workspace. The
         azimuth matters: head-on, the arm reaches straight at the lens and hides the
         block at exactly the moment a grasp is worth watching. Every debug mp4 uses this. -->
    <camera name="agentview" pos="1.05 -0.95 1.00" xyaxes="0.845 0.534 0 -0.325 0.514 0.793" fovy="45"/>

    <body name="block" pos="0.50 0.00 0.02">
      <freejoint name="block_free"/>
      <geom name="block" type="box" size="0.02 0.02 0.02" mass="0.05"
        friction="1.5 0.005 0.0001" material="block_mat"/>
    </body>

    <!-- The three goal objects are static: a layout moves them by editing body_pos. The
         two that a given episode does not use get parked off the floor plane's useful area. -->
    <body name="plate" pos="3.00 0.00 0.00">
      <geom name="plate" type="cylinder" size="0.09 0.0075" pos="0 0 0.0075" material="plate_mat"/>
    </body>
    <body name="pad" pos="3.00 0.50 0.00">
      <geom name="pad" type="box" size="0.05 0.05 0.0025" pos="0 0 0.0025" material="pad_mat"/>
    </body>
    <body name="box" pos="3.00 1.00 0.00">
      <geom name="box" type="box" size="0.04 0.04 0.04" pos="0 0 0.04" material="box_mat"/>
    </body>
  </worldbody>
</mujoco>
